+      if (res.ok) {
+        const data = await res.json();
+        setUser(data);
+      } else {
+        // Token 无效，清除
+        localStorage.removeItem('accessToken');
+        localStorage.removeItem('refreshToken');
+      }
+    } catch {
+      // 网络错误，保留 token
+    } finally {
+      setLoading(false);
+    }
+  }
