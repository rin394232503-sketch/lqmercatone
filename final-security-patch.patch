+// ===== Add Product =====
+function addProduct() {
+  const name = document.getElementById('fName').value.trim();
+  const brand = document.getElementById('fBrand').value.trim();
+  const category = document.getElementById('fCat').value;
+  const emoji = document.getElementById('fEmoji').value.trim();
+  const price = parseFloat(document.getElementById('fPrice').value);
+  const old_price = document.getElementById('fOldPrice').value ? parseFloat(document.getElementById('fOldPrice').value) : null;
+  const tag = document.getElementById('fTag').value || null;
+  const on_sale = parseInt(document.getElementById('fOnSale').value);
+
+  if (!name) { showToast('⚠️ 请输入商品名称'); return; }
+  if (isNaN(price) || price <= 0) { showToast('⚠️ 请输入有效价格'); return; }
+
+  const maxId = products.reduce((max, p) => Math.max(max, p.id), 0);
+  products.push({id: maxId + 1, name, brand, category, emoji, price, old_price, tag, on_sale});
+  saveProducts();
+  // Sync to Supabase
+  saveProductToDB({name, brand, category, price, old_price, emoji, tag, on_sale: on_sale === 1});
+
+  // Clear form
+  ['fName','fBrand','fEmoji','fPrice','fOldPrice'].forEach(id => document.getElementById(id).value = '');
+  showToast('✅ 商品已添加！自动同步中...');
+  autoSyncToGitHub();
+
+  // Go to products page
+  showPage('products', document.querySelectorAll('.nav-item')[0]);
+}
