+function deleteProduct(id) {
+  if (!confirm('确定删除这个商品？')) return;
+  products = products.filter(p => p.id !== id);
+  saveProducts();
+  deleteProductFromDB(id);
+  renderProducts();
+  showToast('🗑️ 商品已删除');
+}
+
+// ===== Sync to GitHub =====
+async function syncToGitHub(silent = false) {
+  const token = document.getElementById('ghToken').value.trim();
+  const repo = document.getElementById('ghRepo').value.trim();
+  if (!token) { showToast('⚠️ 请输入 GitHub Token'); return; }
+
+  const status = document.getElementById('syncStatus');
+  const text = document.getElementById('syncText');
+  status.className = 'sync-status';
+  text.textContent = '正在同步...';
+
+  try {
+    // Get current file SHA
+    const fileRes = await fetch(`https://api.github.com/repos/${repo}/contents/public/index.html`, {
+      headers: { 'Authorization': 'token ' + token }
+    });
+    const fileData = await fileRes.json();
+
+    // Read current index.html
+    const htmlRes = await fetch(window.location.origin + '/index.html');
+    let html = await htmlRes.text();
+
+    // Replace PRODUCTS array
+    const productsStr = 'const PRODUCTS = ' + JSON.stringify(products, null, 2) + ';';
+    html = html.replace(/const PRODUCTS = \[[\s\S]*?\];/, productsStr);
+
+    // Encode and push
+    const content = btoa(unescape(encodeURIComponent(html)));
+    const pushRes = await fetch(`https://api.github.com/repos/${repo}/contents/public/index.html`, {
+      method: 'PUT',
+      headers: {
+        'Authorization': 'token ' + token,
+        'Content-Type': 'application/json'
+      },
+      body: JSON.stringify({
+        message: '📦 更新商品数据 - ' + new Date().toISOString().slice(0,10),
+        content: content,
+        sha: fileData.sha
+      })
+    });
+
+    if (pushRes.ok) {
+      status.className = 'sync-status';
+      text.textContent = '✅ 同步成功！Vercel 将在 1-2 分钟内自动更新';
+      if (!silent) showToast('✅ 同步成功！'); else console.log('Auto-sync success');
+    } else {
+      const err = await pushRes.json();
+      status.className = 'sync-status error';
+      text.textContent = '❌ 同步失败: ' + (err.message || '未知错误');
+      if (!silent) showToast('❌ 同步失败'); else console.log('Auto-sync failed');
+    }
+  } catch (e) {
+    status.className = 'sync-status error';
+    text.textContent = '❌ 网络错误: ' + e.message;
+    if (!silent) showToast('✅ 同步成功！'); else console.log('Auto-sync success');
+  }
+}
+
