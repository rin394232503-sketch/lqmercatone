+// ===== 管理员登录鉴权 =====
+(function checkAdminAuth() {
+  const adminSession = localStorage.getItem('admin_session');
+  if (!adminSession) {
+    window.location.href = '/manage-login.html?redirect=' + encodeURIComponent(window.location.pathname);
+    return;
+  }
+  try {
+    const session = JSON.parse(adminSession);
+    // 检查是否过期（24 小时）
+    if (session.expiresAt && Date.now() > session.expiresAt) {
+      localStorage.removeItem('admin_session');
+      window.location.href = '/manage-login.html?expired=1&redirect=' + encodeURIComponent(window.location.pathname);
+      return;
+    }
+    // 检查角色
+    if (session.role !== 'ADMIN' && session.role !== 'WAREHOUSE') {
+      localStorage.removeItem('admin_session');
+      window.location.href = '/manage-login.html?forbidden=1';
+      return;
+    }
+  } catch (e) {
+    localStorage.removeItem('admin_session');
+    window.location.href = '/manage-login.html?error=1';
+  }
+})();
