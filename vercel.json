{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/uploads/(.*)", "dest": "server.js" },
    { "src": "/sitemap.xml", "dest": "server.js" },
    { "src": "/robots.txt", "dest": "public/robots.txt" },
    { "src": "/admin.html", "dest": "public/admin.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
