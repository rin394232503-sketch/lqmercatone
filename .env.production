# ===== 生产环境变量配置 =====
# 在 Railway 后台设置这些变量

# 应用
NODE_ENV=production
PORT=3001

# 数据库（Supabase - 从后台获取实际值）
# DATABASE_URL=postgresql://postgres.[密码]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[密码]@db.[项目ID].supabase.co:5432/postgres

# JWT
JWT_SECRET=改为随机长字符串_至少32字符
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=改为另一个随机长字符串
JWT_REFRESH_EXPIRES_IN=7d

# Stripe（从 Stripe Dashboard 获取）
# STRIPE_SECRET_KEY=sk_live_xxxxx（正式环境用 live 密钥）
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Twilio（注册后获取）
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_PHONE_NUMBER=+39xxxxx

# SendGrid（注册后获取）
# SENDGRID_API_KEY=SG.xxxxx

# Supabase Storage
# SUPABASE_STORAGE_URL=https://[项目ID].supabase.co/storage/v1
# SUPABASE_ANON_KEY=xxxxx

# Redis（Upstash 免费版）
# REDIS_URL=redis://xxxxx
